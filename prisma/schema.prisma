generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (-pooler): la app
  directUrl = env("DIRECT_URL")   // directa: solo prisma migrate
}

// ─── Enums nativos de BD (valores estables) ──────────────────────────

enum Rol {
  admin
  cliente
}

enum TipoObra {
  vivienda_nueva
  ampliacion
  otro
}

enum TipoConstruccion {
  tradicional
  seco
  no_sabe
  integral
}

enum RangoM2 {
  hasta_50
  m50_100
  m100_200
  mas_200
}

enum PlazoInicio {
  lo_antes_posible
  en_1_mes
  en_3_meses
  en_6_meses
  no_sabe
}

enum EstadoObra {
  en_curso
  pausada
  finalizada
  entregada
}

enum EstadoPago {
  registrado
  confirmado
}

// ─── Enums nuevos (Módulos 5-7) ────────────────────────────────────

enum CargoEmpleado {
  ingeniero
  arquitecto
  maestro_obra
  albanil
  electricista
  plomero
  ayudante
  administrativo
}

enum EstadoHerramienta {
  disponible
  en_uso
  mantenimiento
  baja
}

enum TipoMultimedia {
  foto
  video
  pdf
  plano
  documento
  otro
}

enum EstadoTestimonio {
  pendiente
  aprobado
  rechazado
  oculto
}

enum TipoEventoCalendario {
  nota
  recordatorio
  inicio_etapa
  fin_etapa
  entrega
  reunion
  otro
}

// ─── Entidades Fase 1 ───────────────────────────────────────────────

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  apellidos    String
  email        String   @unique
  passwordHash String   @map("password_hash")
  rol          Rol      @default(cliente)
  clienteId    String?  @unique @map("cliente_id")
  cliente      Cliente? @relation(fields: [clienteId], references: [id])
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en")

  eventosCreados        EventoCalendario[]
  actualizacionesSubidas ActualizacionObra[]
  testimoniosCreados    Testimonio[]
  chatSesiones          ChatSesion[]
  chatAcciones          ChatAccion[]
  chatAccionesConfirmadas ChatAccion[] @relation("ChatAccionConfirmadaPor")

  @@map("usuarios")
}

model InvitacionUsuario {
  id        String   @id @default(cuid())
  clienteId String   @map("cliente_id")
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  token     String   @unique
  usado     Boolean  @default(false)
  expiraEn  DateTime @map("expira_en")
  creadoEn  DateTime @default(now()) @map("creado_en")
  creadoPor String?  @map("creado_por")

  @@index([clienteId])
  @@map("invitaciones_usuario")
}

model Cliente {
  id       String   @id @default(cuid())
  nombre   String
  apellidos String
  telefono String
  email    String?  @unique
  ciudad   String?
  creadoEn DateTime @default(now()) @map("creado_en")

  usuario      Usuario?
  cotizaciones Cotizacion[]
  contratos    Contrato[]
  obras        ObraActiva[]
  testimonios  Testimonio[]
  invitaciones InvitacionUsuario[]
  chatSesiones ChatSesion[]

  @@map("clientes")
}

model Cotizacion {
  id               String         @id @default(cuid())
  clienteId        String         @map("cliente_id")
  cliente          Cliente        @relation(fields: [clienteId], references: [id])
  tipoObra         TipoObra       @map("tipo_obra")
  tipoConstruccion TipoConstruccion @map("tipo_construccion")
  rangoM2          RangoM2        @map("rango_m2")
  ubicacionObra    String?        @map("ubicacion_obra")
  plazoInicio      PlazoInicio    @map("plazo_inicio")
  estado           String         @default("nuevo")
  montoEstimado    Decimal?       @map("monto_estimado") @db.Decimal(12, 2)
  fotoLoteUrl      String?        @map("foto_lote_url")
  fotoLotePublicId String?        @map("foto_lote_public_id")
  requerimiento    String?        @map("requerimiento")
  notasInternas    String?        @map("notas_internas")
  chatTokenIssuedEn DateTime?    @map("chat_token_issued_en")
  creadoEn         DateTime       @default(now()) @map("creado_en")
  actualizadoEn    DateTime       @updatedAt @map("actualizado_en")

  contratos Contrato[]
  chatSesiones ChatSesion[]

  @@index([clienteId])
  @@index([estado])
  @@map("cotizaciones")
}

model Contrato {
  id            String      @id @default(cuid())
  clienteId     String      @map("cliente_id")
  cliente       Cliente     @relation(fields: [clienteId], references: [id])
  cotizacionId  String?     @map("cotizacion_id")
  cotizacion    Cotizacion? @relation(fields: [cotizacionId], references: [id])
  archivoPdfUrl String?     @map("archivo_pdf_url")
  archivoPdfPublicId String? @map("archivo_pdf_public_id")
  fechaFirma    DateTime?   @map("fecha_firma")
  montoTotal    Decimal     @map("monto_total") @db.Decimal(12, 2)
  observaciones String?
  creadoEn      DateTime    @default(now()) @map("creado_en")

  obras ObraActiva[]

  @@index([clienteId])
  @@map("contratos")
}

model ProyectoPortafolio {
  id               String           @id @default(cuid())
  slug             String           @unique
  titulo           String
  tipoConstruccion TipoConstruccion? @map("tipo_construccion")
  m2Construidos    Int?             @map("m2_construidos")
  diasEjecucion    Int?             @map("dias_ejecucion")
  ubicacion        String?

  portadaUrl  String? @map("portada_url")
  portadaPublicId String? @map("portada_public_id")
  videoUrl    String? @map("video_url")
  videoPublicId String? @map("video_public_id")
  galeriaUrls String[] @default([]) @map("galeria_urls")
  galeriaPublicIds String[] @default([]) @map("galeria_public_ids")

  destacado Boolean @default(false)
  publicado Boolean @default(false)
  orden     Int     @default(0)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([publicado, orden])
  @@index([destacado])
  @@index([slug])
  @@map("proyectos_portafolio")
}

model Testimonio {
  id               String   @id @default(cuid())

  obraId           String   @map("obra_id")
  obra             ObraActiva @relation(fields: [obraId], references: [id], onDelete: Cascade)

  clienteId        String?  @map("cliente_id")
  cliente          Cliente? @relation(fields: [clienteId], references: [id])

  creadoPorUsuarioId String? @map("creado_por_usuario_id")
  creadoPor          Usuario? @relation(fields: [creadoPorUsuarioId], references: [id], onDelete: SetNull)

  nombrePublico    String?  @map("nombre_publico")
  texto            String   @db.Text
  fotoUrl          String?  @map("foto_url")
  fotoPublicId     String?  @map("foto_public_id")
  puntaje          Int?

  estado           EstadoTestimonio @default(pendiente)
  publicado        Boolean  @default(false)

  creadoEn         DateTime @default(now()) @map("creado_en")
  actualizadoEn    DateTime @updatedAt @map("actualizado_en")

  @@index([obraId])
  @@index([estado])
  @@index([publicado])
  @@map("testimonios")
}

model Servicio {
  id          String  @id @default(cuid())
  slug        String  @unique
  titulo      String
  descripcion String
  orden       Int     @default(0)
  activo      Boolean @default(true)

  @@map("servicios")
}

model Faq {
  id        String  @id @default(cuid())
  pregunta  String
  respuesta String
  orden     Int     @default(0)
  activo    Boolean @default(true)

  @@map("faqs")
}

model Certificacion {
  id          String  @id @default(cuid())
  titulo      String
  descripcion String
  imageUrl    String? @map("image_url")
  imagePublicId String? @map("image_public_id")
  activo      Boolean @default(true)

  @@map("certificaciones")
}

// ─── Entidades Fase 2 (implementadas) ──────────────────────────────

model ObraActiva {
  id              String     @id @default(cuid())
  clienteId       String     @map("cliente_id")
  contratoId      String?    @map("contrato_id")
  direccionObra   String     @map("direccion_obra")
  fechaInicio     DateTime   @map("fecha_inicio")
  fechaFinEstimada DateTime? @map("fecha_fin_estimada")
  estado          EstadoObra @default(en_curso)
  progreso        Int        @default(0)

  planoDistribucionUrl       String? @map("plano_distribucion_url")
  planoDistribucionPublicId  String? @map("plano_distribucion_public_id")

  cliente       Cliente            @relation(fields: [clienteId], references: [id])
  contrato      Contrato?          @relation(fields: [contratoId], references: [id])
  hitos         HitosObra[]
  pagos         PagoObra[]
  asignaciones  AsignacionObra[]
  materiales    MaterialObra[]
  prestamos     PrestamoHerramienta[]

  eventosCalendario EventoCalendario[]
  actualizaciones   ActualizacionObra[]
  testimonios       Testimonio[]

  @@index([clienteId])
  @@index([contratoId])
  @@map("obras_activas")
}

model HitosObra {
  id             String   @id @default(cuid())
  obraId         String   @map("obra_id")
  titulo         String
  descripcion    String
  fecha          DateTime
  fotoUrl        String?  @map("foto_url")
  fotoPublicId   String?  @map("foto_public_id")
  visibleCliente Boolean  @default(false) @map("visible_cliente")

  obra ObraActiva @relation(fields: [obraId], references: [id])

  @@index([obraId])
  @@map("hitos_obra")
}

model PagoObra {
  id             String     @id @default(cuid())
  obraId         String     @map("obra_id")
  monto          Decimal    @db.Decimal(12, 2)
  fecha          DateTime
  concepto       String
  comprobanteUrl String?    @map("comprobante_url")
  comprobantePublicId String? @map("comprobante_public_id")
  estado         EstadoPago @default(registrado)

  obra ObraActiva @relation(fields: [obraId], references: [id])

  @@index([obraId])
  @@map("pagos_obra")
}

// ─── Nuevos modelos privados del portal cliente ─────────────────────

model EventoCalendario {
  id        String @id @default(cuid())

  obraId    String? @map("obra_id")
  obra      ObraActiva? @relation(fields: [obraId], references: [id], onDelete: Cascade)

  titulo    String
  descripcion String? @db.Text

  tipo      TipoEventoCalendario @default(nota)

  fechaInicio DateTime @map("fecha_inicio")
  fechaFin    DateTime? @map("fecha_fin")
  todoElDia   Boolean @default(true) @map("todo_el_dia")

  visibleCliente Boolean @default(true) @map("visible_cliente")

  creadoPorUsuarioId String? @map("creado_por_usuario_id")
  creadoPor          Usuario? @relation(fields: [creadoPorUsuarioId], references: [id], onDelete: SetNull)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([obraId])
  @@index([fechaInicio])
  @@index([visibleCliente, fechaInicio])
  @@map("eventos_calendario")
}

model ActualizacionObra {
  id      String @id @default(cuid())

  obraId  String @map("obra_id")
  obra    ObraActiva @relation(fields: [obraId], references: [id], onDelete: Cascade)

  tipo    TipoMultimedia

  titulo      String
  descripcion String? @db.Text

  urlArchivo String @map("url_archivo")

  cloudinaryPublicId String? @map("cloudinary_public_id")
  thumbnailUrl       String? @map("thumbnail_url")
  mimeType           String? @map("mime_type")
  formato            String?
  bytes              Int?
  duracionSegundos   Int? @map("duracion_segundos")

  fechaReferencia DateTime? @map("fecha_referencia")

  visibleCliente Boolean @default(true) @map("visible_cliente")
  vistoPorCliente Boolean @default(false) @map("visto_por_cliente")

  subidoPorUsuarioId String? @map("subido_por_usuario_id")
  subidoPor          Usuario? @relation(fields: [subidoPorUsuarioId], references: [id], onDelete: SetNull)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([obraId])
  @@index([tipo])
  @@index([visibleCliente])
  @@index([vistoPorCliente])
  @@index([fechaReferencia])
  @@map("actualizaciones_obra")
}

// ─── Entidades Módulo 5 — Empleados ────────────────────────────────

model Empleado {
  id           String   @id @default(cuid())
  nombre       String
  apellidos    String
  ci           String   @unique
  telefono     String
  cargo        CargoEmpleado
  fechaIngreso DateTime @map("fecha_ingreso")
  salario      Decimal? @db.Decimal(12, 2)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en")

  asignaciones AsignacionObra[]

  @@map("empleados")
}

model AsignacionObra {
  id           String   @id @default(cuid())
  empleadoId   String   @map("empleado_id")
  obraId       String   @map("obra_id")
  rolEnObra    String   @map("rol_en_obra")
  fechaInicio  DateTime @map("fecha_inicio")
  fechaFin     DateTime? @map("fecha_fin")

  empleado Empleado   @relation(fields: [empleadoId], references: [id])
  obra     ObraActiva @relation(fields: [obraId], references: [id])

  @@index([empleadoId])
  @@index([obraId])
  @@map("asignaciones_obra")
}

// ─── Entidades Módulo 6 — Materiales ──────────────────────────────

model Material {
  id            String   @id @default(cuid())
  nombre        String
  unidad        String
  stockActual   Decimal  @map("stock_actual") @db.Decimal(12, 2)
  stockMinimo   Decimal  @map("stock_minimo") @db.Decimal(12, 2)
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  activo        Boolean  @default(true)

  usos MaterialObra[]

  @@map("materiales")
}

model MaterialObra {
  id             String   @id @default(cuid())
  obraId         String   @map("obra_id")
  materialId     String   @map("material_id")
  cantidad       Decimal  @db.Decimal(12, 2)
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(12, 2)
  fecha          DateTime

  obra     ObraActiva @relation(fields: [obraId], references: [id])
  material Material   @relation(fields: [materialId], references: [id])

  @@index([obraId])
  @@index([materialId])
  @@map("materiales_obra")
}

// ─── Entidades Módulo 7 — Herramientas ────────────────────────────

model Herramienta {
  id       String            @id @default(cuid())
  nombre   String
  codigo   String?     @unique
  estado   EstadoHerramienta @default(disponible)
  activo   Boolean           @default(true)

  prestamos PrestamoHerramienta[]

  @@map("herramientas")
}

model PrestamoHerramienta {
  id               String   @id @default(cuid())
  herramientaId    String   @map("herramienta_id")
  obraId           String   @map("obra_id")
  fechaSalida      DateTime @map("fecha_salida")
  fechaDevolucion  DateTime? @map("fecha_devolucion")
  observaciones    String?

  herramienta Herramienta @relation(fields: [herramientaId], references: [id])
  obra        ObraActiva   @relation(fields: [obraId], references: [id])

  @@index([herramientaId])
  @@index([obraId])
  @@map("prestamos_herramienta")
}

// ─── Chat (Punto 1 del chatbot) ──────────────────────────────────────

model ChatSesion {
  id              String   @id @default(cuid()) @map("id")
  sessionId       String   @unique @map("session_id")
  agente          String   @default("publico") @map("agente")
  clienteId       String   @map("cliente_id")
  usuarioId       String?  @map("usuario_id")
  cotizacionId    String?  @map("cotizacion_id")
  mensajeCount    Int      @default(0) @map("mensaje_count")
  estado          String   @default("activa") @map("estado")
  titulo          String?  @map("titulo")
  resumen         String?  @db.Text @map("resumen")
  ultimoMensajeEn DateTime @default(now()) @map("ultimo_mensaje_en")
  creadoEn        DateTime @default(now()) @map("creado_en")

  cliente    Cliente?     @relation(fields: [clienteId], references: [id])
  usuario    Usuario?     @relation(fields: [usuarioId], references: [id])
  cotizacion Cotizacion?  @relation(fields: [cotizacionId], references: [id])
  mensajes   ChatMensaje[]
  acciones   ChatAccion[]

  @@index([clienteId])
  @@index([cotizacionId])
  @@index([usuarioId])
  @@map("chat_sesiones")
}

model ChatMensaje {
  id        String   @id @default(cuid()) @map("id")
  sesionId  String   @map("sesion_id")
  rol       String   // "user" o "assistant"
  contenido String   @db.Text
  metadatos Json?
  creadoEn  DateTime @default(now()) @map("creado_en")

  sesion ChatSesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@index([sesionId, creadoEn])
  @@map("chat_mensajes")
}

model ChatAccion {
  id                 String   @id @default(cuid()) @map("id")
  sesionId           String   @map("sesion_id")
  usuarioId          String   @map("usuario_id")
  herramienta        String   @map("herramienta")
  argumentos         Json
  resultado          Json?
  estado             String   @default("pendiente") @map("estado")
  error              String?  @map("error")
  confirmadaPorUsuarioId String? @map("confirmada_por_usuario_id")
  creadoEn           DateTime @default(now()) @map("creado_en")
  ejecutadoEn        DateTime? @map("ejecutado_en")

  sesion      ChatSesion   @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  confirmadaPor Usuario?   @relation("ChatAccionConfirmadaPor", fields: [confirmadaPorUsuarioId], references: [id])

  @@index([sesionId])
  @@index([estado])
  @@map("chat_acciones")
}

model Conocimiento {
  id          String   @id @default(cuid()) @map("id")
  titulo      String   @map("titulo")
  categoria   String   @map("categoria")
  audiencia   String   @default("publico") @map("audiencia")
  contenido   String   @db.Text @map("contenido")
  activo      Boolean  @default(true) @map("activo")
  version     Int      @default(1) @map("version")
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([categoria])
  @@index([audiencia])
  @@map("conocimiento")
}
