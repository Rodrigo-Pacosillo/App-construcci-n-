# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# lockfile no usado (el proyecto usa npm — ver README)
pnpm-lock.yaml

# metadatos de agentes externos (no son parte de la app)
.atl/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / editor
.agents/
.vscode/
*.swp
*.swo

# Skills system (not part of app)
skills-lock.json

# Documentación de trabajo / specs (no forman parte de la app)
/actual/
/leerCambios/
/docs/
*.md
!README.md
!agents.md

# Scripts de utilidad / migración (solo desarrollo local)
/scripts/

# Assets locales (imágenes source - se usan Cloudinary)
/fotos/
/proyectos/

# TypeScript cache
*.tsbuildinfo